# =============================================
# 环境变量配置模板
# =============================================
# 使用方法：
#   cp .env.example .env
#   然后编辑 .env 填入真实值
#
# ⚠️ .env 文件不要提交到 Git！（已在 .gitignore 中）
# =============================================

# ---------- 数据库 ----------
# MySQL root 密码
DB_ROOT_PASSWORD=请设置一个强密码

# 应用数据库用户名和密码（docker-compose 会自动创建）
DB_USER=agri_app
DB_PASSWORD=请设置应用数据库密码

# ---------- JWT ----------
# 至少 256 位随机字符串。生成方式：openssl rand -hex 32
JWT_SECRET=请生成随机密钥替换这里

# ---------- DeepSeek（对话智能体，必填）----------
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ---------- CORS ----------
# 允许的前端域名，多个用逗号分隔。没有域名可以不填（本地测试）
CORS_ORIGINS=http://localhost:5173

# ---------- Redis（天气缓存）----------
# Docker 部署时由 compose 直接注入 REDIS_HOST=redis，这里无需填写
# 裸机部署可指向本地 Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------- 实例标识 ----------
# 多实例部署时用于日志区分（Docker 下由 compose 注入 node-1 / node-2）
INSTANCE_ID=local

# ---------- Flyway ----------
# 使用 sql/schema.sql + sql/seed-current.sql 初始化全新数据库时，标记库已在 V9
# 通过 Flyway 从空库全量迁移时不要设置（保持默认 1）
# SPRING_FLYWAY_BASELINE_VERSION=9

# ---------- 视觉识别（可选）----------
# 默认复用 DEEPSEEK_API_KEY 与 DeepSeek 地址；如需独立视觉模型再填
# VISION_API_KEY=
# VISION_BASE_URL=https://api.deepseek.com
# VISION_MODEL=deepseek-v4-flash-vision-exp

# ---------- 知识库向量检索（可选）----------
# OpenAI 兼容的 /embeddings 服务；不填时自动使用本地字词哈希向量
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=BAAI/bge-m3

# ---------- 语音识别（可选）----------
# OpenAI 兼容的 /audio/transcriptions；不配置时前端回退到浏览器语音识别
# 国内可用示例：SiliconFlow SenseVoice
# ASR_BASE_URL=https://api.siliconflow.cn/v1
# ASR_API_KEY=
# ASR_MODEL=FunAudioLLM/SenseVoiceSmall
# ASR_LANGUAGE=zh

# ---------- Web Push 预警推送（可选）----------
# 用 VapidKeyGenerator 生成一次后固定使用；多实例必须共享同一对密钥
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ---------- 天气备源（可选）----------
# 配置和风天气 Key 后，Open-Meteo 失败会自动降级
# QWEATHER_API_KEY=

# ---------- 限流（可选）----------
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH_PER_MINUTE=20
# RATE_LIMIT_AGENT_PER_MINUTE=10
# RATE_LIMIT_UPLOAD_PER_MINUTE=6

# ---------- 每日 AI 额度（可选）----------
# AI_QUOTA_ENABLED=true
# AI_DAILY_CHAT_QUOTA=80
