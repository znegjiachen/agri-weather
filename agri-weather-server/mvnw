#!/bin/sh
# Maven Wrapper startup script
MAVEN_PROJECTBASEDIR=$(cd "$(dirname "$0")" && pwd)
export MAVEN_PROJECTBASEDIR
MAVEN_USER_HOME="${HOME}/.m2"
export MAVEN_USER_HOME
MVNW_REPOURL="https://repo.maven.apache.org/maven2"
export MVNW_REPOURL
MAVEN_OPTS="-Xmx1024m"
export MAVEN_OPTS

if [ -n "$JAVA_HOME" ]; then
    JAVA_EXE="$JAVA_HOME/bin/java"
else
    JAVA_EXE="java"
fi

WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_LAUNCHER="org.apache.maven.wrapper.MavenWrapperMain"

exec "$JAVA_EXE" $MAVEN_OPTS -classpath "$WRAPPER_JAR" "-Dmaven.multiModuleProjectDirectory=$MAVEN_PROJECTBASEDIR" "$WRAPPER_LAUNCHER" "$@"
