# =============================================
# 问田 — Git 忽略规则
# =============================================

# ---------- 环境变量 / 敏感信息 ----------
.env
.env.local
.env.*.local
*.pem
*.key
application-local.yml
application-local.yaml
application-local.properties

# ---------- Java / Maven ----------
target/
*.class
*.jar
*.war
!**/maven-wrapper.jar
hs_err_pid*
replay_pid*

# ---------- Node / React ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 运行时产物 ----------
*.tmp
*.bak
logs/
